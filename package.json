{
  "name": "flaky-test-scorer",
  "version": "2.0.0",
  "homepage": "https://github.com/JustasMonkev/flaky-test-scorer",
  "description": "Detect and rank flaky tests from test-run history, with deterministic evidence and agent-ready JSON.",
  "keywords": [
    "flaky",
    "tests",
    "junit",
    "ci",
    "flakiness",
    "test-analytics"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "flaky-test-scorer": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter/playwright": {
      "types": "./dist/reporter/playwright.d.ts",
      "default": "./dist/reporter/playwright.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "lint": "npm run build && eslint dist --max-warnings=0",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run test/e2e.test.ts test/e2e-v3.test.ts test/playwright-real.test.ts test/package-real.test.ts",
    "typecheck": "tsc --project tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
